<resources>
    <style name="platformSettingsTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorPrimary">@color/settings_accent</item>
        <item name="android:colorPrimaryDark">@color/settings_bg</item>
        <item name="android:colorAccent">@color/settings_accent</item>
        <item name="android:colorBackground">@color/settings_bg</item>
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:textColorPrimary">@color/settings_text_primary</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
    </style>
    <style name="platformDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:colorAccent">@color/settings_accent</item>
        <item name="android:textColorPrimary">@color/settings_text_primary</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
    </style>
</resources>
