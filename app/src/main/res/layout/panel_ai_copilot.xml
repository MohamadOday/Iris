<?xml version="1.0" encoding="utf-8"?>
<!-- Material You 3 AI Copilot Overlay Panel -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Material 3 Header Bar -->
    <LinearLayout
        android:id="@+id/ai_header_bar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/ai_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iris Copilot"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/ai_clear_btn"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="Clear"
            android:textSize="10.5sp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/ai_action_copy"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="Copy"
            android:textSize="10.5sp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ai_action_insert"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="Insert"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ai_open_settings_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tune"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="AI Configuration" />
    </LinearLayout>

    <!-- Material 3 Chat Container Card -->
    <ScrollView
        android:id="@+id/ai_console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginBottom="6dp"
        android:scrollbars="vertical">
        <LinearLayout
            android:id="@+id/ai_chat_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <!-- Material 3 Assist Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="6dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ai_tool_smart_compose"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="🧠 Smart Compose"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/ai_tool_simplify"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="✍️ Simplify"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/ai_tool_grammar_fix"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="📝 Grammar Fix"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/ai_tool_explain"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="💻 Explain Code"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/ai_tool_fix"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="🔧 Fix Syntax"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Material 3 Pill Input Container -->
    <LinearLayout
        android:id="@+id/ai_input_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/ai_prompt_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Ask AI Copilot"
            android:textSize="13.5sp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:background="@null"
            android:inputType="textNoSuggestions"
            android:cursorVisible="true" />

        <ImageView
            android:id="@+id/ai_prompt_clear_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Clear prompt" />

        <TextView
            android:id="@+id/ai_paste_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Paste"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/ai_submit_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Send"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
