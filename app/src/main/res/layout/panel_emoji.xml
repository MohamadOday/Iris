<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated Full Emoji View Panel Container -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emoji_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/emoji_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/emoji_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/emoji_delete_btn"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/sym_keyboard_delete"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Backspace" />
    </LinearLayout>
</LinearLayout>
