<nabu.iris.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/inputViewStyle">
    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <!-- Clipboard Suggestion Bar (Hidden by default) -->
        <FrameLayout
            android:id="@+id/clipboard_suggestion_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#00000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/clipboard_suggestion_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Permanent Quick-Access Utility Toolbar (Premium Outlines) -->
        <LinearLayout
            android:id="@+id/utility_toolbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            
            <ImageView
                android:id="@+id/tb_keys_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show Keyboard Keys" />

            <ImageView
                android:id="@+id/tb_clipboard_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_paste"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open Clipboard Panel" />

            <ImageView
                android:id="@+id/tb_ai_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ai_copilot"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open AI Copilot" />

            <ImageView
                android:id="@+id/tb_emoji_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_emoji"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open Emoji Panel" />

            <ImageView
                android:id="@+id/tb_gif_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_gif"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search GIFs" />

            <ImageView
                android:id="@+id/tb_translate_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_translate"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Translate" />

            <ImageView
                android:id="@+id/tb_settings_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_settings"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Keyboard Settings Screen" />
        </LinearLayout>
        
        <!-- Dedicated Full Clipboard View Panel Stub -->
        <ViewStub
            android:id="@+id/clipboard_panel_stub"
            android:inflatedId="@+id/clipboard_panel"
            android:layout="@layout/panel_clipboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Dynamic AI Copilot Overlay Panel Stub -->
        <ViewStub
            android:id="@+id/ai_panel_stub"
            android:inflatedId="@+id/ai_panel"
            android:layout="@layout/panel_ai_copilot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Dedicated Full Emoji View Panel Stub -->
        <ViewStub
            android:id="@+id/emoji_panel_stub"
            android:inflatedId="@+id/emoji_panel"
            android:layout="@layout/panel_emoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Dedicated GIF Search Panel Stub -->
        <ViewStub
            android:id="@+id/gif_panel_stub"
            android:inflatedId="@+id/gif_panel"
            android:layout="@layout/panel_gif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Dedicated Translation Panel Stub -->
        <ViewStub
            android:id="@+id/translate_panel_stub"
            android:inflatedId="@+id/translate_panel"
            android:layout="@layout/panel_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Convenience In-Keyboard AI Settings Panel Stub -->
        <ViewStub
            android:id="@+id/ai_settings_panel_stub"
            android:inflatedId="@+id/ai_settings_panel"
            android:layout="@layout/panel_ai_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Main Keyboard View -->
        <nabu.iris.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</nabu.iris.keyboard.latin.InputView>
