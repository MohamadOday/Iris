<nabu.iris.keyboard.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/inputViewStyle">
    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <!-- Clipboard Suggestion Bar (Hidden by default) -->
        <FrameLayout
            android:id="@+id/clipboard_suggestion_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#00000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/clipboard_suggestion_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- Permanent Quick-Access Utility Toolbar (Premium Outlines) -->
        <LinearLayout
            android:id="@+id/utility_toolbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            
            <ImageView
                android:id="@+id/tb_keys_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Show Keyboard Keys" />

            <ImageView
                android:id="@+id/tb_clipboard_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_paste"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open Clipboard Panel" />

            <ImageView
                android:id="@+id/tb_ai_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ai_copilot"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open AI Copilot" />

            <ImageView
                android:id="@+id/tb_emoji_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_emoji"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open Emoji Panel" />

            <ImageView
                android:id="@+id/tb_gif_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_gif"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Search GIFs" />

            <ImageView
                android:id="@+id/tb_translate_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/ic_translate"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Translate" />

            <ImageView
                android:id="@+id/tb_settings_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/sym_keyboard_settings"
                android:padding="7dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Keyboard Settings Screen" />
        </LinearLayout>
        
        <!-- Dedicated Full Clipboard View Panel -->
        <LinearLayout
            android:id="@+id/clipboard_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            
            <!-- Scrollable list of items -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/clipboard_items_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Dynamic AI Copilot Overlay Panel -->
        <LinearLayout
            android:id="@+id/ai_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <!-- Sleek Header Bar inside AI panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI COPILOT"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:typeface="monospace"/>

                <TextView
                    android:id="@+id/ai_clear_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLEAR"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/ai_action_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COPY"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/ai_action_insert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSERT"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <ImageView
                    android:id="@+id/ai_open_settings_btn"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tune"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="AI Configuration"/>
            </LinearLayout>

            <!-- Sleek Scrollable Chat Dialogue List -->
            <ScrollView
                android:id="@+id/ai_console_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:layout_marginBottom="6dp"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/ai_chat_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp" />
            </ScrollView>

            <!-- Utility Actions integrated in Header -->

            <!-- Inline Assist Tools Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="6dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/ai_tool_smart_compose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 Smart Compose"
                        android:textSize="10.5sp"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"/>
                    <TextView
                        android:id="@+id/ai_tool_simplify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✍️ Simplify"
                        android:textSize="10.5sp"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"/>
                    <TextView
                        android:id="@+id/ai_tool_grammar_fix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Grammar Fix"
                        android:textSize="10.5sp"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"/>
                    <TextView
                        android:id="@+id/ai_tool_explain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💻 Explain Code"
                        android:textSize="10.5sp"
                        android:padding="6dp"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"/>
                    <TextView
                        android:id="@+id/ai_tool_fix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔧 Fix Syntax"
                        android:textSize="10.5sp"
                        android:padding="6dp"
                        android:clickable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Custom Prompt Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/ai_prompt_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Type prompt..."
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:imeOptions="actionSend"
                    android:padding="8dp"
                    android:inputType="textNoSuggestions"
                    android:cursorVisible="true" />
                <TextView
                    android:id="@+id/ai_paste_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:layout_marginStart="6dp" />
                <TextView
                    android:id="@+id/ai_submit_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated Full Emoji View Panel Container -->
        <LinearLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/emoji_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/emoji_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingEnd="16dp">
                <ImageView
                    android:id="@+id/emoji_delete_btn"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/sym_keyboard_delete"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Backspace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated GIF Search Panel -->
        <LinearLayout
            android:id="@+id/gif_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <!-- Search Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/gif_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search GIFs..."
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@null"
                    android:inputType="textNoSuggestions"
                    android:cursorVisible="true" />

                <TextView
                    android:id="@+id/gif_clear_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="CLEAR"
                    android:textColor="#FF7C4DFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Grid or List of GIFs -->
            <ScrollView
                android:id="@+id/gif_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fillViewport="true">
                <LinearLayout
                    android:id="@+id/gif_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Dedicated Translation Panel -->
        <LinearLayout
            android:id="@+id/translate_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <!-- Translate Header Row (Languages and Mode selection) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/translate_source_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Auto-detect"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/translate_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text=" → "
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/translate_target_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Spanish"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Weight spacer to push mode selector to the right -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/translate_mode_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Mode: Scraping"
                    android:textColor="?attr/functionalTextColor"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />


            </LinearLayout>

            <!-- Download/Translation Progress Bar -->
            <!-- Download progress label + bar -->
            <TextView
                android:id="@+id/translate_download_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                android:layout_marginBottom="2dp" />

            <ProgressBar
                android:id="@+id/translate_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:layout_marginBottom="4dp" />

            <!-- Translate Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/translate_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Type to translate..."
                    android:textColorHint="#66FFFFFF"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@null"
                    android:inputType="textNoSuggestions"
                    android:cursorVisible="true"
                    android:textDirection="anyRtl"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/translate_clear_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="CLEAR"
                    android:textColor="#FF7C4DFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Result Row (Preview & Insert Action) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/translate_result_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:textDirection="anyRtl"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/translate_insert_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="INSERT"
                    android:textColor="#FF00E676"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>



        <!-- Convenience In-Keyboard AI Settings Panel -->
        <LinearLayout
            android:id="@+id/ai_settings_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <!-- Premium Compact Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/setup_back_btn"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:text="‹"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:id="@+id/settings_panel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI CONFIG"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:typeface="monospace"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/setup_save_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="SAVE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Provider Selection Segmented Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/setup_prov_ollama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OLLAMA"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"/>
                <TextView
                    android:id="@+id/setup_prov_gemini"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GEMINI"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"/>
                <TextView
                    android:id="@+id/setup_prov_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CUSTOM"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:clickable="true"/>
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Gemini Key Input Container -->
                    <LinearLayout
                        android:id="@+id/setup_gemini_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:id="@+id/setup_gemini_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GEMINI API KEY"
                            android:textSize="9.5sp"
                            android:layout_marginBottom="2dp"/>
                        <EditText
                            android:id="@+id/setup_gemini_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Paste Gemini Key..."
                            android:textSize="11.5sp"
                            android:singleLine="true"
                            android:padding="8dp"
                            android:inputType="textNoSuggestions"
                            android:cursorVisible="true" />
                    </LinearLayout>

                    <!-- Host URL & Model Name (Side-by-Side Premium Compact Row!) -->
                    <LinearLayout
                        android:id="@+id/setup_host_model_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">
                        
                        <LinearLayout
                            android:id="@+id/setup_host_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:id="@+id/setup_host_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="API ENDPOINT URL"
                                android:textSize="9.5sp"
                                android:layout_marginBottom="2dp"/>
                            <EditText
                                android:id="@+id/setup_host_url"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="http://localhost:11434"
                                android:textSize="11.5sp"
                                android:singleLine="true"
                                android:padding="8dp"
                                android:inputType="textNoSuggestions"
                                android:cursorVisible="true" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/setup_model_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/setup_model_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MODEL NAME"
                                android:textSize="9.5sp"
                                android:layout_marginBottom="2dp"/>
                            <EditText
                                android:id="@+id/setup_model_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="qwen2.5-coder"
                                android:textSize="11.5sp"
                                android:singleLine="true"
                                android:padding="8dp"
                                android:inputType="textNoSuggestions"
                                android:cursorVisible="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Custom Headers Input Container -->
                    <LinearLayout
                        android:id="@+id/setup_headers_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:id="@+id/setup_headers_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CUSTOM HTTP HEADERS (JSON)"
                            android:textSize="9.5sp"
                            android:layout_marginBottom="2dp"/>
                        <EditText
                            android:id="@+id/setup_headers_json"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint='{"Authorization":"Bearer ..."}'
                            android:textSize="11.5sp"
                            android:singleLine="true"
                            android:padding="8dp"
                            android:inputType="textNoSuggestions"
                            android:cursorVisible="true" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Save/Back controls are integrated in the header row above -->
        </LinearLayout>

        <!-- Main Keyboard View -->
        <nabu.iris.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</nabu.iris.keyboard.latin.InputView>
