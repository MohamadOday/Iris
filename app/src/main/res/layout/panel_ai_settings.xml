<?xml version="1.0" encoding="utf-8"?>
<!-- Convenience In-Keyboard AI Settings Panel -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:padding="8dp">

    <!-- Premium Compact Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:id="@+id/setup_back_btn"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:text="‹"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/settings_panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI CONFIG"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:gravity="center"/>
        <TextView
            android:id="@+id/setup_save_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="SAVE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Provider Selection Segmented Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/setup_prov_ollama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OLLAMA"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"/>
        <TextView
            android:id="@+id/setup_prov_gemini"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GEMINI"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"/>
        <TextView
            android:id="@+id/setup_prov_custom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CUSTOM"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Gemini Key Input Container -->
            <LinearLayout
                android:id="@+id/setup_gemini_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/setup_gemini_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEMINI API KEY"
                    android:textSize="9.5sp"
                    android:layout_marginBottom="2dp"/>
                <EditText
                    android:id="@+id/setup_gemini_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste Gemini Key..."
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:padding="8dp"
                    android:inputType="textNoSuggestions"
                    android:cursorVisible="true" />
            </LinearLayout>

            <!-- Host URL & Model Name (Side-by-Side Premium Compact Row!) -->
            <LinearLayout
                android:id="@+id/setup_host_model_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                
                <LinearLayout
                    android:id="@+id/setup_host_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/setup_host_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API ENDPOINT URL"
                        android:textSize="9.5sp"
                        android:layout_marginBottom="2dp"/>
                    <EditText
                        android:id="@+id/setup_host_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="http://localhost:11434"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:padding="8dp"
                        android:inputType="textNoSuggestions"
                        android:cursorVisible="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/setup_model_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/setup_model_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MODEL NAME"
                        android:textSize="9.5sp"
                        android:layout_marginBottom="2dp"/>
                    <EditText
                        android:id="@+id/setup_model_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="qwen2.5-coder"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:padding="8dp"
                        android:inputType="textNoSuggestions"
                        android:cursorVisible="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Custom Headers Input Container -->
            <LinearLayout
                android:id="@+id/setup_headers_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:id="@+id/setup_headers_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUSTOM HTTP HEADERS (JSON)"
                    android:textSize="9.5sp"
                    android:layout_marginBottom="2dp"/>
                <EditText
                    android:id="@+id/setup_headers_json"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint='{"Authorization":"Bearer ..."}'
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:padding="8dp"
                    android:inputType="textNoSuggestions"
                    android:cursorVisible="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
